package-as: WowSync

enable-nolib-creation: no

externals:
  Libs/LibStub: https://repos.curseforge.com/wow/libstub/trunk
  Libs/CallbackHandler-1.0: https://repos.curseforge.com/wow/callbackhandler/trunk
  Libs/AceDB-3.0: https://repos.curseforge.com/wow/ace3/trunk/AceDB-3.0
  Libs/Contracts: https://github.com/Eyal-WowHub/Contracts
  Libs/Addon: https://github.com/Eyal-WowHub/Addon
  Libs/CharacterInfo: https://github.com/Eyal-WowHub/CharacterInfo
  AddOns/WowSync_UI: https://github.com/Eyal-WowHub/WowSync_UI

ignore:
  - Libs/LibStub.lua
  - Libs/**/LibStub/*
  - Libs/**/*.toc
  - Libs/**/*.textile
  - README.md

move-folders:
  WowSync/Libs/CallbackHandler-1.0/CallbackHandler-1.0: WowSync/Libs/CallbackHandler-1.0
  WowSync/AddOns/WowSync_UI: WowSync_UI